{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contact-form-worker",
  "main": "src/index.js",
  // Newest date the bundled runtime in wrangler 4.150.0 supports.
  "compatibility_date": "2026-10-06",

  // DNS for fusioncam.co is at Porkbun, not Cloudflare, so the Worker runs on its
  // workers.dev address only. No routes or custom domains.
  "workers_dev": true,
  "preview_urls": false,

  "observability": {
    "enabled": true
  },

  // Non-secret settings. RESEND_API_KEY and TURNSTILE_SECRET_KEY are set with
  // `wrangler secret put`, never here. For local dev, .dev.vars overrides these.
  "vars": {
    "TO_EMAIL": "scott@livetools.com.au",
    "FROM_EMAIL": "fusioncam.co form <forms@mail.fusioncam.co>",
    "ALLOWED_ORIGINS": "https://fusioncam.co,https://www.fusioncam.co",
    "ALLOWED_HOSTNAMES": "fusioncam.co,www.fusioncam.co",
    "SUBJECT_PREFIX": "[fusioncam.co]",
    "REDIRECT_URL": "https://fusioncam.co/thanks.html"
  },

  // A loose filter: about 5 submissions a minute per visitor IP. Turnstile is the real gate.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
